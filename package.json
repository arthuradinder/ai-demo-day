{
  "name": "ai-demo-day-deck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Demo Day deck — Nairobi AI Community x The AI Collective (Nairobi Chapter), AI Automations Training Cohort 2",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-qr.mjs && tsc --noEmit && vite build && node scripts/inline-dist.mjs",
